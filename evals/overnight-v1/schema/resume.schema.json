{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Overnight Benchmark Resume",
  "type": "object",
  "required": ["id", "source", "candidate_alias", "experiences"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^rs-[0-9]{2}$"},
    "source": {"enum": ["REAL_AUTHORIZED", "PUBLIC_SOURCE", "SYNTHETIC", "DEMO"]},
    "source_note": {"type": "string"},
    "candidate_alias": {"type": "string", "description": "化名；真实个人信息禁止入库"},
    "city": {"type": "string"},
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institution", "degree", "field_of_study", "dates"],
        "additionalProperties": false,
        "properties": {
          "institution": {"type": "string"},
          "degree": {"type": "string"},
          "field_of_study": {"type": "string"},
          "dates": {"type": "string"}
        }
      }
    },
    "experiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "organization", "type", "dates", "bullets"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "organization": {"type": "string"},
          "type": {"enum": ["INTERNSHIP", "JOB", "PROJECT"]},
          "dates": {"type": "string"},
          "bullets": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 8}}
        }
      }
    },
    "skills": {"type": "array", "items": {"type": "string"}},
    "raw_text": {"type": "string", "minLength": 40, "description": "喂给被测系统的简历原文（化名）"}
  }
}
