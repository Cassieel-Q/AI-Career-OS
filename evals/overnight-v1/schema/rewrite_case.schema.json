{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Overnight Benchmark Rewrite Case",
  "type": "object",
  "required": ["id", "pair_id", "resume_id", "jd_id", "bullet_index", "original_bullet", "ground_truth"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^rw-[0-9]{3}$"},
    "pair_id": {"type": "string", "pattern": "^pr-[0-9]{3}$"},
    "resume_id": {"type": "string", "pattern": "^rs-[0-9]{2}$"},
    "jd_id": {"type": "string", "pattern": "^jd-[0-9]{3}$"},
    "bullet_index": {"type": "integer", "minimum": 0},
    "original_bullet": {"type": "string", "minLength": 8},
    "ground_truth": {
      "type": "object",
      "required": ["expected_decision", "fact_status"],
      "additionalProperties": false,
      "properties": {
        "expected_decision": {"enum": ["KEEP_AND_HIGHLIGHT", "KEEP", "DEEMPHASIZE", "OMIT"]},
        "fact_status": {"enum": ["SUPPORTED", "NEEDS_CONFIRMATION", "UNSUPPORTED", "CONTRADICTED"]},
        "allowed_rewrites": {"type": "array", "items": {"type": "string"}, "description": "可接受改写示例（不唯一，仅作评分参照）"},
        "forbidden": {"type": "array", "items": {"type": "string"}, "description": "改写中不允许出现的内容（编造的数字/公司/技能等）"}
      }
    }
  }
}
